# Copy to .env and fill in. Never commit .env.

# Serper — https://serper.dev (image search)
SERPER_API_KEY=

# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# Background generation is off by default; see README.
ENHANCE_ENABLED=false

# Phase 2 — OMS base URL (no trailing path)
OMS_URL=

# OMS account email (not a credential — Woopsa is passwordless)
OMS_LOGIN_EMAIL=
